{
  "name": "Transformer_Inference",
  "description": "Transformer model inference scenario for NLP and vision transformer workloads",
  "version": "1.0",
  "model_config": {
    "architecture": "transformer",
    "hidden_size": 768,
    "num_attention_heads": 12,
    "num_hidden_layers": 12,
    "intermediate_size": 3072,
    "max_sequence_length": 512,
    "vocab_size": 30522
  },
  "operations": [
    {
      "type": "embedding",
      "config": {
        "vocab_size": 30522,
        "embedding_dim": 768
      },
      "input_shapes": [
        [1, 512]
      ],
      "output_validation": {
        "enabled": true,
        "tolerance": 1e-05,
        "reference_impl": "numpy"
      }
    },
    {
      "type": "layer_norm",
      "config": {
        "normalized_shape": [768],
        "eps": 1e-12
      },
      "input_shapes": [
        [1, 512, 768]
      ],
      "output_validation": {
        "enabled": true,
        "tolerance": 1e-05,
        "reference_impl": "numpy"
      }
    },
    {
      "type": "matmul",
      "config": {
        "transpose_b": false
      },
      "input_shapes": [
        [1, 512, 768],
        [768, 2304]
      ],
      "output_validation": {
        "enabled": true,
        "tolerance": 1e-05,
        "reference_impl": "numpy"
      }
    },
    {
      "type": "multi_head_attention",
      "config": {
        "num_heads": 12,
        "head_dim": 64,
        "dropout": 0.0,
        "scale": 0.125
      },
      "input_shapes": [
        [1, 12, 512, 64],
        [1, 12, 512, 64],
        [1, 12, 512, 64]
      ],
      "output_validation": {
        "enabled": true,
        "tolerance": 1e-04,
        "reference_impl": "numpy"
      }
    },
    {
      "type": "softmax",
      "config": {
        "axis": -1
      },
      "input_shapes": [
        [1, 12, 512, 512]
      ],
      "output_validation": {
        "enabled": true,
        "tolerance": 1e-05,
        "reference_impl": "numpy"
      }
    },
    {
      "type": "add",
      "config": {
        "alpha": 1.0,
        "beta": 1.0
      },
      "input_shapes": [
        [1, 512, 768],
        [1, 512, 768]
      ],
      "output_validation": {
        "enabled": true,
        "tolerance": 1e-05,
        "reference_impl": "numpy"
      }
    },
    {
      "type": "matmul",
      "config": {
        "transpose_b": false
      },
      "input_shapes": [
        [1, 512, 768],
        [768, 3072]
      ],
      "output_validation": {
        "enabled": true,
        "tolerance": 1e-05,
        "reference_impl": "numpy"
      }
    },
    {
      "type": "gelu",
      "config": {
        "approximate": true
      },
      "input_shapes": [
        [1, 512, 3072]
      ],
      "output_validation": {
        "enabled": true,
        "tolerance": 1e-04,
        "reference_impl": "numpy"
      }
    },
    {
      "type": "matmul",
      "config": {
        "transpose_b": false
      },
      "input_shapes": [
        [1, 512, 3072],
        [3072, 768]
      ],
      "output_validation": {
        "enabled": true,
        "tolerance": 1e-05,
        "reference_impl": "numpy"
      }
    }
  ],
  "performance_targets": {
    "latency_ms": 50,
    "throughput_ops": 200,
    "memory_mb": 512
  },
  "optimization_hints": {
    "use_flash_attention": true,
    "fuse_qkv_projection": true,
    "use_fp16_accumulation": false,
    "cache_attention_weights": true
  }
}
