 *
 * Optimized tiled matrix multiplication with Vulkan subgroup extensions.
 * C = A * B where A is MxK, B is KxN, C is MxN
 *
 * Performance optimizations:
 * 1. Shared memory tiling for coalesced global memory access
 * 2. 4x loop unrolling in the inner product computation
 * 3. Barrier synchronization for tile loading coordination
 *
 * Note: Subgroup extensions are enabled for forward compatibility.
 * The current algorithm uses a one-thread-per-output-element pattern
 * where each thread computes a full dot product independently.
 * Subgroup operations (like subgroupAdd for parallel reduction)
 * would require a different algorithm variant where multiple threads
 * collaborate on computing each output element.
 */

#version 450
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_basic : enable

// Tile size for workgroup - each thread computes one element per tile iteration
// 16x16 = 256 threads per workgroup, optimal for most GPUs
#define TILE_SIZE 16

layout(local_size_x = TILE_SIZE, local_size_y = TILE_SIZE) in;

layout(set = 0, binding = 0) readonly buffer A { float data[]; } a;
layout(set = 0, binding = 1) readonly buffer B { float data[]; } b;
layout(set = 0, binding = 2) writeonly buffer C { float data[]; } c;

layout(push_constant) uniform PushConstants {
    uint M;  // Rows of A and C
    uint N;  // Columns of B and C
    uint K;  // Columns of A, Rows of B
} pc;

// Shared memory tiles for coalesced memory access
shared float tileA[TILE_SIZE][TILE_SIZE];
shared float tileB[TILE_SIZE][TILE_SIZE];

void main() {
    uint row = gl_GlobalInvocationID.y;
    uint col = gl_GlobalInvocationID.x;

    uint localRow = gl_LocalInvocationID.y;
    uint localCol = gl_LocalInvocationID.x;

    // Accumulator for dot product
    float acc = 0.0;

    // Number of tiles needed to cover K dimension
    uint numTiles = (pc.K + TILE_SIZE - 1) / TILE_SIZE;

    for (uint t = 0; t < numTiles; t++) {
        // Collaborative loading of tiles into shared memory
        uint aCol = t * TILE_SIZE + localCol;
        uint bRow = t * TILE_SIZE + localRow;

        // Load tile from matrix A with bounds checking
        if (row < pc.M && aCol < pc.K) {
            tileA[localRow][localCol] = a.data[row * pc.K + aCol];
        } else {
            tileA[localRow][localCol] = 0.0;
        }

        // Load tile from matrix B with bounds checking
        if (bRow < pc.K && col < pc.N) {
            tileB[localRow][localCol] = b.data[bRow * pc.N + col];
        } else {
            tileB[localRow][localCol] = 0.0;
        }

        // Synchronize to ensure tile is fully loaded
        barrier();

        // Compute partial dot product for this tile
        // Unroll inner loop for better performance
        float localSum = 0.0;

        for (uint k = 0; k < TILE_SIZE; k += 4) {
            localSum += tileA[localRow][k] * tileB[k][localCol];
            localSum += tileA[localRow][k + 1] * tileB[k + 1][localCol];
            localSum += tileA[localRow][k + 2] * tileB[k + 2][localCol];
            localSum += tileA[localRow][k + 3] * tileB[k + 3][localCol];
        }

        acc += localSum;

        // Synchronize before loading next tile
        barrier();
    }

    // Write result with bounds checking
    // Each thread computes one unique output element C[row,col], so no
    // subgroup reduction is needed here. The performance comes from:
    // - Shared memory tiling: reduces global memory bandwidth
    // - Loop unrolling: better instruction-level parallelism
    // - Coalesced access: threads in a workgroup access adjacent memory
    if (row < pc.M && col < pc.N) {
        c.data[row * pc.N + col] = acc;
    }
}
